# .dockerignore - 排除不必要文件减小构建上下文

.git
.github
.opencode
.agents
.vscode
.idea

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# 测试与开发文件
tests/
scripts/
memory_comparison.md
tmp.txt

# 环境变量（密钥不进镜像）
.env
.env.*

# 构建产物
build/
dist/
