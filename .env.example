# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=kb_app
MYSQL_PASSWORD=123
MYSQL_DATABASE=ai_knowledge

# LLM
LLM_PROVIDER_ENCRYPTION_KEY=change-me-to-a-secure-passphrase
LLM_DEFAULT_PROVIDER_CODE=deepseek

# LLM（废弃，保留向后兼容，多供应商管理启用后由 DB 配置替代）
LLM_API_KEY=your-ark-api-key-here
LLM_API_BASE=https://ark.cn-beijing.volces.com/api/plan
LLM_MODEL=ark-code-latest

# Telegram（可选，未配置则跳过）
TELEGRAM_BOT_TOKEN=

# 飞书（可选，未配置则跳过）
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# GitHub API Token（可选，提升限速）
GITHUB_TOKEN=

# LLM 预算控制（0 = 不限）
# 每日上限：当天所有成功调用的成本累计超过此值后，新调用将被阻止（CNY）
LLM_BUDGET_DAILY_CNY=0.50
# 每日上限（USD）
LLM_BUDGET_DAILY_USD=0
# 单次调用上限：单次调用成本超过此值时发出告警日志（CNY）
LLM_BUDGET_PER_CALL_CNY=0.10
# 单次调用上限（USD）
LLM_BUDGET_PER_CALL_USD=0

# 工作流全局预算守卫（CostGuard）：单次工作流运行的累计成本上限（元）
# 超限后 chat_completion 抛 BudgetExceededError，节点捕获后跳过后续 LLM 调用
BUDGET_YUAN=10.0
